generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────


enum Role {
  SELLER
  BUYER
}

enum BookCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum ListingType {
  SELL
  DONATE
  EXCHANGE
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// ─────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────


model User {
  id    String @id @default(cuid())
  email String @unique
  passwordHash String
  name         String
  phone        String?
  city         String?
  roles        Role[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  books        Book[]
  requests     BookRequest[]

  @@map("users")
}

model Book {
  id    String @id @default(cuid())
  title String
  author String?
  grade  String
  subject String
  schoolName  String?
  condition   BookCondition
  listingType ListingType
  price       Decimal? @db.Decimal(10, 2)
  description String?
  photoKeys   String[]
  isAvailable Boolean @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  sellerId    String
  seller      User          @relation(fields: [sellerId], references: [id])

  requests    BookRequest[]

  @@map("books")
}

model BookRequest {
  id String @id @default(cuid())
  status RequestStatus @default(PENDING)
  message   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  bookId  String
  book    Book    @relation(fields: [bookId], references: [id])

  buyerId String
  buyer   User    @relation(fields: [buyerId],  references: [id])

  @@map("book_requests")
}